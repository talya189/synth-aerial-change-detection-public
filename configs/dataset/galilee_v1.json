{
  "name": "galilee_v1",
  "description": "Galilee / Jordan-gorge villages on Copernicus terrain; mixed nadir and oblique views, 0.15-0.5 m GSD.",
  "scene_config": "configs/scene/galilee_village.json",
  "seeds": {"start": 1000, "count": 50},
  "overrides": {
    "terrain": {"site_top_k": 6},
    "camera": {
      "resolution": [1024, 1024],
      "view_sampler": {
        "count": [3, 4],
        "tilt_deg": [[0, 0.4], [15, 0.15], [30, 0.15], [45, 0.15], [65, 0.15]],
        "gsd_m": [[0.15, 0.2], [0.25, 0.35], [0.35, 0.25], [0.5, 0.2]],
        "village_fraction": 0.65
      }
    },
    "render": {"samples": 64}
  },
  "splits": {"train": 0.8, "val": 0.1, "test": 0.1},
  "coco_classes": ["building", "vegetation", "asphalt_road", "dirt_road", "path_sidewalk"],
  "min_instance_pixels": 12,
  "output": "outputs/datasets/galilee_v1"
}
